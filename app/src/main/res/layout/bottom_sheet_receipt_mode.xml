<?xml version="1.0" encoding="utf-8"?>
<!-- [주은] 4. 영수증 등록 방식 선택 (바텀시트) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_large">

    <!-- 안내 문구 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_tiny"
        android:text="영수증을 등록할 방식을 \n선택해 주세요"
        android:textColor="@color/text_black"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold" />

    <!-- [4.1.2] 영수증 촬영하기 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="촬영 아이콘"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mode_camera" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영수증 촬영하기"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:lineSpacingExtra="2dp"
                    android:text="카메라로 영수증을 촬영해\n자동으로 정보를 불러와요"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="이동"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_gray" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- [4.1.3] 갤러리에서 불러오기 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="갤러리 아이콘"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mode_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="갤러리에서 불러오기"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:lineSpacingExtra="2dp"
                    android:text="저장된 이미지를 선택해\n자동으로 정보를 불러와요"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="이동"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_gray" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- [4.1.4] 직접 입력하기 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_manual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="직접 입력 아이콘"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mode_manual" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="직접 입력하기"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:lineSpacingExtra="2dp"
                    android:text="영수증 정보가 없을 때\n직접 입력할 수 있어요"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="이동"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_gray" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>