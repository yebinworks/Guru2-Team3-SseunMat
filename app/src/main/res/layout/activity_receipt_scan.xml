<?xml version="1.0" encoding="utf-8"?>
<!-- [예빈] 5. 영수증 스캔 및 AI 분석 화면 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.write.ReceiptScanActivity">

    <!-- 메인 촬영/가이드 화면 영역 -->
    <LinearLayout
        android:id="@+id/layout_camera_guide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_small"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/spacing_small">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="뒤로가기"
                android:src="@drawable/ic_custom_revert"
                app:tint="@color/text_black" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="영수증 등록"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <!-- 우측 대칭 맞춤용 여백 -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- 메인 메세지 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingExtra="4dp"
            android:text="등록하려는\n영수증을 촬영해 주세요"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />

        <!-- 프리뷰 이미지 영역 (둥근 모서리 적용) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/v_camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="영수증 촬영 예시"
                android:scaleType="centerCrop"
                android:src="@drawable/img_receipt_preview" />
        </androidx.cardview.widget.CardView>

        <!-- 촬영 가이드 문구 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="이렇게 찍어주세요!"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:lineSpacingExtra="6dp"
            android:text="• 상호명, 결제 날짜, 최종 결제 금액이 보여야 합니다. \n• 초점을 잘 맞춰주세요. \n• 당해 당월의 영수증을 사용해주세요."
            android:textColor="@color/text_gray"
            android:textSize="@dimen/text_size_body" />

        <!-- 하단 여백 스페이스 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 하단 촬영 버튼 -->
        <Button
            android:id="@+id/btn_receipt_capture"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginBottom="@dimen/spacing_small"
            android:backgroundTint="@color/main_purple"
            android:text="영수증 촬영하기"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            app:cornerRadius="@dimen/input_corner_radius" />
    </LinearLayout>

    <!-- 5.3.2 AI 분석 중 로딩 오버레이 레이아웃 -->
    <LinearLayout
        android:id="@+id/layout_analysis_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/main_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="영수증 정보를 읽고 있어요"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="상호명, 결제 날짜, 최종 결제 금액을 분석 중이에요"
            android:textColor="@color/text_gray"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>