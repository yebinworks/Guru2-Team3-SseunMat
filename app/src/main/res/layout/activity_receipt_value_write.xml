<?xml version="1.0" encoding="utf-8"?>
<!-- [예빈] 6.4~6.7 가치 선택 및 세부 입력 화면 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.write.ReceiptValueWriteActivity">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_custom_revert"
            app:tint="@color/text_black" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="영수증 등록"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="@dimen/spacing_small">

            <!-- 6.4 가치 선택 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:lineSpacingExtra="4dp"
                android:text="이 소비가 내게 남긴 가치를\n하나 선택해 주세요."
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <!-- 7가지 가치 이미지 버튼 그리드 -->
            <GridLayout
                android:id="@+id/grid_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:columnCount="3">

                <!-- 1. 위로 -->
                <ImageButton
                    android:id="@+id/btn_val_consolation"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="위로"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_consolation_off" />

                <!-- 2. 휴식 -->
                <ImageButton
                    android:id="@+id/btn_val_rest"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="휴식"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_rest_off" />

                <!-- 3. 관계 -->
                <ImageButton
                    android:id="@+id/btn_val_relation"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="관계"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_relation_off" />

                <!-- 4. 추억 -->
                <ImageButton
                    android:id="@+id/btn_val_memory"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="추억"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_memory_off" />

                <!-- 5. 배움 -->
                <ImageButton
                    android:id="@+id/btn_val_learning"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="배움"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_learning_off" />

                <!-- 6. 영감 -->
                <ImageButton
                    android:id="@+id/btn_val_inspiration"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="영감"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_inspiration_off" />

                <!-- 7. 마음표현 -->
                <ImageButton
                    android:id="@+id/btn_val_expression"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="마음표현"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_val_expression_off" />
            </GridLayout>

            <!-- 6.5 만족도 입력 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:lineSpacingExtra="4dp"
                android:text="이 소비가 내게 얼마나\n좋은 경험으로 남았나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_rating_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dot_rating_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_rating_dot_off" />
            </LinearLayout>

            <!-- 6.6 짧은 글 메모 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:lineSpacingExtra="4dp"
                android:text="이 소비로\n남은 감정이나 기억이 있나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_memo"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_input_box"
                android:gravity="top|start"
                android:hint="남기고 싶은 감정이나 기억을 적어 주세요"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/text_black"
                android:textColorHint="@color/text_light_gray"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="100자 이내로 작성해주세요"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_size_small" />

            <!-- 6.7 기부 여부 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="이 소비는 기부였나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="기부 기록이라면 선택해 주세요"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_size_body" />

            <CheckBox
                android:id="@+id/cb_donation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="  기부로 기록하기"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>
    </ScrollView>

    <!-- 영수증 저장/등록 버튼 -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height_primary"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_small"
        android:backgroundTint="@color/btn_disabled"
        android:enabled="false"
        android:text="영수증 등록하기"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_subtitle"
        android:textStyle="bold"
        app:cornerRadius="@dimen/input_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>