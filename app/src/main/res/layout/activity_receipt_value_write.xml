<?xml version="1.0" encoding="utf-8"?>
<!--[예빈]-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".ui.write.ReceiptValueWriteActivity">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_custom_revert" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="영수증 등록"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 6.4 가치 선택 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이 소비가 내게 남긴 가치를\n하나 선택해 주세요."
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <!-- 7가지 가치 그리드/플로우 레이아웃 -->
            <GridLayout
                android:id="@+id/grid_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:columnCount="3">

                <!-- 위로, 휴식, 관계, 추억, 배움, 영감, 마음 표현 -->
                <Button
                    android:id="@+id/btn_val_consolation"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="위로"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_rest"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="휴식"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_relation"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="관계"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_memory"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="추억"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_learning"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="배움"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_inspiration"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="영감"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_val_expression"
                    style="?android:attr/selectableItemBackground"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_value_chip_selector"
                    android:text="마음\n표현"
                    android:textColor="@color/selector_value_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </GridLayout>

            <!-- 6.5 만족도 입력 (5단계 척도) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="이 소비가 내게 얼마나\n좋은 경험으로 남았나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_rating_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dot_rating_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_rating_dot_off" />

                <ImageView
                    android:id="@+id/dot_rating_5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_rating_dot_off" />
            </LinearLayout>

            <!-- 6.6 짧은 글 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="이 소비로\n남은 감정이나 기억이 있나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_memo"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_box"
                android:gravity="top|start"
                android:hint="남기고 싶은 감정이나 기억을 적어 주세요"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="100자 이내로 작성해주세요"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_size_small" />

            <!-- 6.7 기부 여부 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="이 소비는 기부였나요?"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="기부 기록이라면 선택해 주세요"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_size_body" />

            <CheckBox
                android:id="@+id/cb_donation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="  기부로 기록하기"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>
    </ScrollView>

    <!-- 영수증 저장하기 버튼 -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height_primary"
        android:layout_margin="20dp"
        android:backgroundTint="@color/btn_disabled"
        android:enabled="false"
        android:text="영수증 저장하기"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>